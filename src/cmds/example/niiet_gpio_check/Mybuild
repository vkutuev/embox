package embox.cmd.example.niiet_gpio_check

@AutoCmd
@Cmd(name = "niiet_gpio_check",
	help = "Reproduce and verify the niiet_gpio driver IRQ-attach bug",
	man = '''
		NAME
			niiet_gpio_check - check the niiet_gpio IRQ-attach fix
		SYNOPSIS
			niiet_gpio_check
		DESCRIPTION
			Runs two checks against the K1921VG1T GPIO interrupt path.
			Check 1 fails on the unpatched driver (interrupt silently
